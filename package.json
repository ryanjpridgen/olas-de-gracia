{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "bun": "^1.4.4",
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1"
    }
  },
  "dependencies": {
    "@types/bun": "^1.4.4"
  }
}
