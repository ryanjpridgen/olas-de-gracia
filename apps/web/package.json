{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"dependencies": {
		"@vinext/cloudflare": "latest",
		"fflate": "^0.8.3",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"vinext": "latest",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@tailwindcss/postcss": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"cf": "latest",
		"eslint": "10.9.1",
		"tailwindcss": "latest",
		"typescript": "latest",
		"vite": "8.3.0"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"deploy": "[ \"$ENVIRONMENT\" = \"production\" ] && vinext-cloudflare deploy || vinext-cloudflare previews deploy $ENVIRONMENT --mode staging",
		"preview": "pnpm run build && pnpm run start",
		"cf-typegen": "cf workers types",
		"lint": "eslint --max-warnings 0"
	}
}